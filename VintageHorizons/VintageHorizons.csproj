<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DodensLandscapes</AssemblyName>
    <RootNamespace>VintageHorizons</RootNamespace>
    <Version>0.5.1-dev.5</Version>
  </PropertyGroup>

  <!-- No debug info in Release: the zip never ships the .pdb, and generating one
       stamps its absolute path (with the builder's username) into the DLL. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Game install: set VINTAGE_STORY, falls back to the local install -->
  <PropertyGroup>
    <GamePath>$(VINTAGE_STORY)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' or !Exists('$(GamePath)')">$(HOME)/Games/vintagestory1.22.5</GamePath>
  </PropertyGroup>

  <!-- The fast check tier reaches a few network handlers that are otherwise private;
       see tests/VintageHorizons.Checks. Nothing else has access. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VintageHorizons.Checks" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(GamePath)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Vanilla's public regional snow snapshots drive finite dormant-terrain refreshes. -->
    <Reference Include="VSEssentials">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Chiselled blocks: capture reads what a BlockEntityMicroBlock is made of. -->
    <Reference Include="VSSurvivalMod">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Settings window: measures a label so one too long for its column shrinks to fit. -->
    <Reference Include="cairo-sharp">
      <HintPath>$(GamePath)/Lib/cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>$(GamePath)/Lib/Microsoft.Data.Sqlite.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(GamePath)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(GamePath)/Lib/OpenTK.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Assemble a loadable mod folder at bin/<Config>/Mods/dodenslandscapes (loaded via the addModPath launch flag) -->
  <Target Name="PackageModFolder" AfterTargets="Build">
    <PropertyGroup>
      <ModFolder>$(OutputPath)Mods/dodenslandscapes/</ModFolder>
    </PropertyGroup>
    <ItemGroup>
      <AssetFiles Include="assets/**/*" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModFolder)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(ModFolder)" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="modinfo.json" DestinationFolder="$(ModFolder)" />
    <!-- Every copy carries the GPL-3 text, our notice with its Vintage Story exception, and
         the MIT notices of the work this mod adapts, which those licences require. -->
    <Copy SourceFiles="../LICENSE;../NOTICE;../THIRD-PARTY-NOTICES" DestinationFolder="$(ModFolder)" />
    <Copy SourceFiles="modicon.png" DestinationFolder="$(ModFolder)" Condition="Exists('modicon.png')" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFolder="$(ModFolder)assets/%(RecursiveDir)" />
  </Target>

</Project>
