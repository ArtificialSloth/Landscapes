<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dumps the mod's own column fingerprints for a savegame, using the shipping code rather
    than a copy of the rule. Reimplementing the hash is how an offline tool silently starts
    reporting every column as changed the day the rule moves; this cannot drift because it
    calls LodSavegameScan directly.

      dotnet run (project scripts/fingerprint-dump) WORLD.vcdbs out.tsv
      scripts/claim-check.py out.tsv <worldid>-server.db by-minute

    See Program.cs for the exact command line; MSBuild forbids a double dash in a comment.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>fingerprint-dump</AssemblyName>
    <RootNamespace>VintageHorizons.Tools</RootNamespace>
    <!-- Never shipped; this exists to be run from the repository. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <GamePath>$(VINTAGE_STORY)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' or !Exists('$(GamePath)')">$(HOME)/Games/vintagestory1.22.5</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../VintageHorizons/VintageHorizons.csproj" />
    <!-- The checks project's logger, compiled rather than copied. -->
    <Compile Include="../../tests/VintageHorizons.Checks/CaptureLogger.cs" Link="CaptureLogger.cs" />
  </ItemGroup>

  <!--
    The same game references as the checks project, copy-local so this host can resolve them.
    SQLitePCLRaw and its native library come too: outside the game process nothing has called
    Batteries_V2.Init, and without e_sqlite3 beside the binary every open fails with a
    provider error that reads like a corrupt savegame.
  -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(GamePath)/VintagestoryLib.dll</HintPath>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/Lib/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>$(GamePath)/Lib/Microsoft.Data.Sqlite.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2">
      <HintPath>$(GamePath)/Lib/SQLitePCLRaw.batteries_v2.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>$(GamePath)/Lib/SQLitePCLRaw.core.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3">
      <HintPath>$(GamePath)/Lib/SQLitePCLRaw.provider.e_sqlite3.dll</HintPath>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(GamePath)/Lib/protobuf-net.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(GamePath)/Lib/e_sqlite3.dll" Condition="Exists('$(GamePath)/Lib/e_sqlite3.dll')">
      <Link>e_sqlite3.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
